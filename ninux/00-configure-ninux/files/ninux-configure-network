#!/bin/bash
set -euo pipefail

# Configure a static IPv4 address after flashing, or restore DHCP.
# This helper intentionally does not run during image creation.

if [[ ${EUID} -ne 0 ]]; then
    echo "Esegui con sudo: sudo $0 [--dhcp]" >&2
    exit 1
fi

if ! command -v nmcli >/dev/null 2>&1; then
    echo "NetworkManager/nmcli non è disponibile. Nessuna modifica effettuata." >&2
    exit 1
fi

usage() {
    echo "Uso: $0 [--dhcp]"
    echo "Senza argomenti configura un IPv4 statico in modo interattivo."
}

MODE="static"
if [[ ${1:-} == "--dhcp" ]]; then
    MODE="dhcp"
elif [[ -n ${1:-} ]]; then
    usage
    exit 2
fi

mapfile -t IFACES < <(nmcli -t -f DEVICE,TYPE device status | awk -F: '$2 == "ethernet" && $1 != "lo" {print $1}')
if ((${#IFACES[@]} == 0)); then
    echo "Nessuna interfaccia Ethernet gestita da NetworkManager." >&2
    exit 1
fi

echo "Interfacce Ethernet disponibili:"
select IFACE in "${IFACES[@]}"; do
    [[ -n ${IFACE:-} ]] && break
done

CON_NAME=$(nmcli -g GENERAL.CONNECTION device show "$IFACE" | head -n1)
if [[ -z "$CON_NAME" || "$CON_NAME" == "--" ]]; then
    CON_NAME="ninux-${IFACE}"
    nmcli connection add type ethernet ifname "$IFACE" con-name "$CON_NAME" >/dev/null
fi

if [[ "$MODE" == "dhcp" ]]; then
    nmcli connection modify "$CON_NAME" ipv4.method auto ipv4.addresses "" ipv4.gateway "" ipv4.dns ""
    nmcli connection up "$CON_NAME"
    echo "DHCP ripristinato su $IFACE."
    exit 0
fi

read -r -p "Indirizzo IPv4 con prefisso (es. 192.168.1.50/24): " ADDRESS
read -r -p "Gateway IPv4 (es. 192.168.1.1): " GATEWAY
read -r -p "DNS (separati da virgola, es. 1.1.1.1,8.8.8.8): " DNS

python3 - "$ADDRESS" "$GATEWAY" <<'PY'
import ipaddress, sys
try:
    ipaddress.ip_interface(sys.argv[1])
    ipaddress.ip_address(sys.argv[2])
except ValueError as exc:
    raise SystemExit(f"Valore IP non valido: {exc}")
PY

nmcli connection modify "$CON_NAME" \
    ipv4.method manual \
    ipv4.addresses "$ADDRESS" \
    ipv4.gateway "$GATEWAY" \
    ipv4.dns "$DNS"
nmcli connection up "$CON_NAME"
echo "Configurazione statica applicata a $IFACE."
